# FrankenPHP worker stacks: nginx serves the static files and
# resolves the upstream per request, as on every stack, and hands PHP to
# FrankenPHP over HTTP where the FPM stacks use FastCGI. The nginx image fills
# in the PHRAMARK_ values from compose.yaml and leaves nginx's own variables.
server {
    listen 80;
    resolver 127.0.0.11 valid=5s ipv6=off;
    set $php ${PHRAMARK_WORKER_PHP}:80;
    root /var/www/html;
    index index.php;
    gzip off;
    location / { try_files $uri $uri/ @front; }
    # A path under /manager/ that is not a file is a manager route (evo-ui's
    # /manager/evo-ui?action=update): FrankenPHP hands it to manager/index.php
    # (Caddyfile), with the client's host like the rest of the manager. A
    # missing asset stays a 404, as on the FPM stacks.
    location ~ ^/manager/.+\.(js|mjs|css|map|png|jpe?g|gif|svg|ico|webp|woff2?|ttf|eot)$ {
        try_files $uri =404;
    }
    location /manager/ { try_files $uri $uri/ @manager; }
    location @manager {
        proxy_pass http://$php;
        proxy_set_header Host $http_host;
    }
    # A worker serves one origin (EVO_WORKER_ORIGIN) and answers any other
    # with 421, while the harness reaches the stack as 127.0.0.1:PORT and by
    # its nginx service: front-end requests carry that origin's host. The pages
    # link relatively, so the host appears nowhere in what is measured.
    location @front {
        proxy_pass http://$php;
        proxy_set_header Host ${PHRAMARK_WORKER_ORIGIN};
    }
    location = /index.php {
        proxy_pass http://$php;
        proxy_set_header Host ${PHRAMARK_WORKER_ORIGIN};
    }
    # The manager runs as classic PHP and keeps the client's host, as it
    # does behind FastCGI.
    location ~ \.php$ {
        proxy_pass http://$php;
        proxy_set_header Host $http_host;
    }
}
