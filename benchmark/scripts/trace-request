#!/usr/bin/env sh
# Records the real request path of one stack: which vendor packages and
# namespaces a warm category request (or any PATH) actually executes.
#
#   benchmark/scripts/trace-request PORT [PATH]
#
# The prepend hook is installed into the stack's PHP-FPM container for the
# duration of the trace and removed again; FPM and nginx are restarted around
# it because OPcache validation is off and nginx caches the upstream address.
set -eu

port=${1:?Usage: trace-request PORT [PATH]}
path=${2:-/articles/category-042}
host=${PHRAMARK_HOST:-127.0.0.1}

case "$port" in
  8080) php=phramark-php-parser-1; nginx=phramark-nginx-parser-1; stack=evo-parser ;;
  8081) php=phramark-php-latte-1; nginx=phramark-nginx-latte-1; stack=evo-latte ;;
  8082) php=phramark-php-phalcon-1; nginx=phramark-nginx-phalcon-1; stack=evo-phalcon ;;
  8083) php=phramark-php-drupal-1; nginx=phramark-nginx-drupal-1; stack=drupal ;;
  8084) php=phramark-php-typo3-1; nginx=phramark-nginx-typo3-1; stack=typo3 ;;
  8085) php=phramark-php-latte-parser-1; nginx=phramark-nginx-latte-parser-1; stack=evo-latte-parser ;;
  8086) php=phramark-php-winter-1; nginx=phramark-nginx-winter-1; stack=winter ;;
  8087) php=phramark-php-modx-1; nginx=phramark-nginx-modx-1; stack=modx ;;
  8088) php=phramark-php-wordpress-gantry-1; nginx=phramark-nginx-wordpress-gantry-1; stack=wordpress-gantry ;;
  *) echo "PORT must be 8080 through 8088" >&2; exit 2 ;;
esac

export MSYS_NO_PATHCONV=1
mkdir -p benchmark/results
docker cp benchmark/fixtures/trace-prepend.php "$php:/usr/local/etc/php/phramark-trace.php"
docker exec "$php" sh -c 'printf "auto_prepend_file=/usr/local/etc/php/phramark-trace.php\n" > /usr/local/etc/php/conf.d/zz-phramark-trace.ini'
restart() {
  docker restart "$php" >/dev/null
  docker restart "$nginx" >/dev/null
  sleep 2
}
cleanup() {
  docker exec "$php" rm -f /usr/local/etc/php/conf.d/zz-phramark-trace.ini /usr/local/etc/php/phramark-trace.php
  restart
}
trap cleanup EXIT
restart

# First request warms OPcache and CMS caches; the second is the one recorded.
curl -fsS "http://$host:$port$path" >/dev/null
curl -fsS "http://$host:$port$path" >/dev/null
output=benchmark/results/trace-$stack.json
docker exec "$php" cat /tmp/phramark-trace.json > "$output"
echo "Trace written to $output"
php benchmark/scripts/trace-summary.php "$output" "$stack"
