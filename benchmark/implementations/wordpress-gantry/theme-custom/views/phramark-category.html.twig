{# Copied to wp-content/themes/g5_hydrogen/custom/views by the setup script:
   Gantry resolves gantry-theme://views through the theme's custom/ prefix
   first. Extends the theme's page partial, so the outline (header, navigation,
   main, footer sections and their particles) renders around the content. #}
{% extends "partials/page.html.twig" %}
{% set twigTemplate = 'phramark-category.html.twig' %}
{% set scope = 'page' %}

{% block content %}
    <header><a href="/">Phramark benchmark</a></header>
    <main><h1>{{ title|e }}</h1><p class="intro">{{ introtext|e }}</p><section class="articles">
    {% for article in articles %}
      <article>
        <img src="{{ article.hero_image|e }}" alt="">
        <h2><a href="/articles/{{ categoryAlias|e }}/{{ article.alias|e }}">{{ article.title|e }}</a></h2>
        <p class="intro">{{ article.introtext|e }}</p>
        <p class="meta"><span class="author">{{ article.author|e }}</span> · <span class="reading-time">{{ article.reading_time|e }} min</span></p>
      </article>
    {% endfor %}
    </section></main><footer>Deterministic CMS benchmark fixture</footer>
{% endblock %}
